{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KokoroAnd",
  "identifier": "com.kokoroand.tts",
  "build": {
    "beforeDevCommand": "bun run --cwd ../ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run --cwd ../ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "KokoroAnd",
        "width": 420,
        "height": 780
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "android": {
      "minSdkVersion": 26
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
